{
  "name": "semantic-review",
  "version": "0.4.0",
  "description": "Semantic diff review for coding agents: an LLM turns a git diff into a narrative HTML report, a human comments on it, and the feedback comes back as plaintext.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "agent-skills",
    "code-review",
    "pi-package"
  ],
  "repository": "github:mikker/semantic-review",
  "bin": {
    "semantic-review": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "semantic-review.webp"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:ui && npm run build:cli",
    "build:cli": "esbuild src/cli.ts --bundle --packages=external --platform=node --format=esm --outfile=dist/cli.js",
    "build:ui": "vite build ui",
    "dev:ui": "vite dev ui",
    "prepublishOnly": "npm run build",
    "test": "bun test",
    "eval": "bun evals/run.ts",
    "typecheck": "tsc --noEmit",
    "check:ui": "svelte-check --tsconfig ui/tsconfig.json"
  },
  "dependencies": {
    "@pierre/diffs": "^1.3.4",
    "beautiful-mermaid": "^1.1.3",
    "zod": "^4"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/bun": "^1.3.0",
    "esbuild": "^0.28.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.0",
    "vite": "^8.2.1"
  }
}
